### ===============================
### CREATE PROPERTY (OWNER ONLY)
### ===============================
POST {{baseUrl}}/properties
Authorization: Bearer {{token}}
Content-Type: {{json}}

{
  "title": "2 BHK Flat in Delhi",
  "description": "parking space, well furnished",
  "price": 35000,
  "purpose": "rent",
  "propertyType": "flat",
  "bhk": 3,
  "area": 1200,
  "city": "Mumbai",
  "locality": "Patel nagar"
}


### ===============================
### GET ALL PROPERTIES (PUBLIC)
### ===============================
GET {{baseUrl}}/properties/my

Authorization: Bearer {{token}}


### ===============================
### FILTER PROPERTIES (LIKE 99ACRES)
### ===============================
GET {{baseUrl}}/properties?city=Delhi&purpose=rent
