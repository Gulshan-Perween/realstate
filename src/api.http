### ===============================
### BASE CONFIG
### ===============================

@baseUrl = http://localhost:5000/api
@json = application/json


### ===============================
### HEALTH CHECK
### ===============================
GET http://localhost:5000/health


### ===============================
### REGISTER USER (OWNER)
### ===============================
POST {{baseUrl}}/auth/register
Content-Type: {{json}}

# {
#   "name": "John Owner",
#   "email": "owner@test.com",
#   "password": "123456",
#   "role": "owner"
# }

{
  "name": "Admin",
  "email": "admin@test.com",
  "password": "123456",
  "role": "admin"
}


### ===============================
### REGISTER USER (NORMAL USER)
### ===============================
POST {{baseUrl}}/auth/register
Content-Type: {{json}}

{
  "name": "Normal User",
  "email": "user@test.com",
  "password": "123456"
}


### ===============================
### LOGIN USER
### ===============================
POST {{baseUrl}}/auth/login
Content-Type: {{json}}

# {
#   "email": "owner@test.com",
#   "password": "123456"
# }

{
    "email": "raj@gmail.com",
  "password": "123456"
  }

